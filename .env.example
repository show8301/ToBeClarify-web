# Server-side endpoint used by the same-origin /api/admin proxy.
PUBLIC_CLIENT_API_BASE_URL=https://api.marchgroup.net/api/client
ADMIN_API_BASE_URL=https://api.marchgroup.net/api/admin
ORDERING_API_BASE_URL=https://api.marchgroup.net/api/client/ordering
PUBLIC_MEDIA_BASE_URL=https://api.marchgroup.net/api/client/media

# Set to the external website origin behind IIS (no trailing slash).
# Local direct access defaults to the request origin.
# CUSTOMER_PORTAL_PUBLIC_ORIGIN=https://www-dev.marchgroup.net
