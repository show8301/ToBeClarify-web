[
  {
    "selector": ".adminNavLabel",
    "declarations": { "font-size": "12px", "line-height": "1.2" }
  },
  {
    "selector": ".adminTopbarBrand",
    "declarations": {
      "display": "grid",
      "grid-template": "\"mark copy\" 44px \"site site\" auto / 44px minmax(0, 1fr)",
      "align-items": "center",
      "gap": "12px",
      "text-align": "left"
    }
  },
  {
    "selector": ".adminTopbarMark",
    "declarations": { "width": "44px", "height": "44px" }
  },
  {
    "selector": ".adminTopbarMark img",
    "declarations": { "width": "100%", "height": "100%", "object-fit": "contain" }
  },
  {
    "selector": ".adminTopbarBrandCopy",
    "declarations": {
      "display": "grid",
      "height": "44px",
      "grid-template-rows": "26px 14px",
      "align-content": "space-between",
      "text-align": "left"
    }
  },
  {
    "selector": ".adminTopbarBrandCopy strong",
    "declarations": { "font-size": "21px", "line-height": "26px", "font-weight": "700" }
  },
  {
    "selector": ".adminTopbarBrandCopy small",
    "declarations": { "font-size": "11px", "line-height": "14px", "font-weight": "500", "margin-top": "0" }
  },
  {
    "selector": ".adminBrandSiteLink",
    "declarations": {
      "justify-content": "center",
      "text-align": "center",
      "min-height": "34px",
      "margin-top": "0",
      "padding": "6px 12px",
      "font-size": "13px"
    }
  },
  {
    "selector": ".adminTopbarBrand",
    "context": ["@media (max-width: 1020px)"],
    "declarations": { "display": "flex", "flex-direction": "row", "text-align": "left", "padding": "0" }
  },
  {
    "selector": ".adminTopbarBrandCopy",
    "context": ["@media (max-width: 1020px)"],
    "declarations": { "display": "block", "height": "auto" }
  },
  {
    "selector": ".adminBrandSiteLink",
    "context": ["@media (max-width: 1020px)"],
    "declarations": { "display": "none" }
  },
  {
    "selector": ".adminTopbarBrandCopy small",
    "context": ["@media (max-width: 680px)"],
    "declarations": { "display": "none" }
  },
  {
    "selector": ".adminBrandSiteLink",
    "context": ["@media (pointer: coarse)"],
    "declarations": { "min-height": "44px" }
  }
]
