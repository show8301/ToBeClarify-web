[
  { "selector": ".serviceMetrics > button", "declarations": { "display": "grid", "grid-template-areas": "\"topic quantity\" \"detail detail\"", "min-width": "0", "min-height": "112px" } },
  { "selector": ".adminRoleDashboard-service .serviceMetrics > button > span", "declarations": { "grid-area": "topic" } },
  { "selector": ".adminRoleDashboard-service .serviceMetrics > button > strong", "declarations": { "grid-area": "quantity", "place-self": "start end" } },
  { "selector": ".serviceTaskHead", "declarations": { "display": "flex", "justify-content": "space-between" } },
  { "selector": ".serviceTaskDetail", "declarations": { "display": "grid", "gap": "14px" } },
  { "selector": ".serviceGuestFilters", "declarations": { "display": "grid", "grid-template-columns": "minmax(0, 2fr) repeat(2, minmax(0, 1fr))" } },
  { "selector": ".adminAdmissionSummary dl", "declarations": { "display": "grid", "grid-template-columns": "repeat(2, minmax(0, 1fr))" } },
  { "selector": ".adminTheme .adminAdmissionSummary dl", "declarations": { "display": "grid", "grid-template-columns": "minmax(0, 1fr)", "overflow-x": "auto" } },
  { "selector": ".adminCreateSessionPanel > form > .adminAdmissionPayment", "declarations": { "flex": "1 0 100%", "box-sizing": "border-box" } },
  { "selector": ".adminCreateSessionPanel .adminAdmissionPayment", "declarations": { "display": "grid", "grid-template-columns": "minmax(0, 1fr) max-content", "align-items": "end", "gap": "8px 12px" } },
  { "selector": ".adminAdmissionOverview", "declarations": { "grid-column": "1 / -1" } },
  { "selector": ".adminAdmissionOverviewPrimary", "declarations": { "display": "flex", "flex-wrap": "wrap", "align-items": "baseline" } },
  { "selector": ".adminAdmissionOverviewPrimary h3", "declarations": { "font-size": "16px" } },
  { "selector": ".adminAdmissionOverviewReceived strong", "declarations": { "font-size": "20px" } },
  { "selector": ".adminAdmissionOverviewMeta", "declarations": { "display": "flex", "font-size": "12px" } },
  { "selector": ".adminAdmissionFields", "declarations": { "display": "flex", "flex-wrap": "wrap" } },
  { "selector": ".adminAdmissionFields", "declarations": { "grid-column": "1", "min-width": "0" } },
  { "selector": ".adminCreateSessionPanel .adminAdmissionFields select", "declarations": { "width": "15em", "max-width": "100%" } },
  { "selector": ".adminCreateSessionPanel .adminAdmissionFields input[type=\"number\"]", "declarations": { "width": "15ch", "max-width": "100%" } },
  { "selector": ".adminAdmissionPaymentActions", "declarations": { "display": "flex", "grid-column": "2", "align-self": "end", "justify-content": "flex-end" } },
  { "selector": ".adminCreateSessionPanel .adminAdmissionConfirm input[type=\"checkbox\"]", "declarations": { "width": "20px", "min-height": "20px" } },
  { "selector": ".serviceGuestFilters", "context": ["@media (max-width: 760px)"], "declarations": { "grid-template-columns": "minmax(0, 1fr)" } },
  { "selector": ".adminCreateSessionPanel .adminAdmissionPayment", "context": ["@media (max-width: 760px)"], "declarations": { "grid-template-columns": "minmax(0, 1fr)", "align-items": "start" } },
  { "selector": ".adminAdmissionPaymentActions", "context": ["@media (max-width: 760px)"], "declarations": { "grid-column": "1", "justify-content": "space-between" } },
  { "selector": ".adminAdmissionOverviewPrimary .adminAdmissionOverviewReceived", "context": ["@media (max-width: 760px)"], "declarations": { "margin-left": "0" } },
  { "selector": ".serviceTaskActions .adminButton", "context": ["@media (max-width: 760px)"], "declarations": { "min-height": "44px" } }
]
